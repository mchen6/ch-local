{
  "name": "@countinghouse/ch-local",
  "version": "1.0.0",
  "description": "The countinghouse client-pack launcher: installs pinned packs into ~/.countinghouse, starts the runtime over stdio for Claude Code, Cursor, VS Code and Codex, prints each client's config entry, upgrades on request and never silently.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mchen6/ch-local.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "ch-local": "bin/ch-local.js"
  },
  "files": [
    "bin/",
    "lib/",
    "clients/"
  ],
  "scripts": {
    "test": "node scripts/test.js"
  },
  "dependencies": {
    "@sigstore/bundle": "4.0.0",
    "@sigstore/core": "3.2.1",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/verify": "3.1.1"
  },
  "bundleDependencies": [
    "@sigstore/bundle",
    "@sigstore/core",
    "@sigstore/protobuf-specs",
    "@sigstore/verify"
  ]
}
