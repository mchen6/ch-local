{
  "_source": "countinghouse docs/superpowers/specs/shared-runtime-wire/vectors.json conditionsWhy, from countinghouse branch c-conditions-why-vectors (PR pending): copied, never edited here",
  "conditionsWhy": {
    "rule": "on a status-ok client line whose conditions is \"no\", an optional why: exactly {reason} or {reason, at}. reason is one of reasons; at is \"~/\" and a path under the user's home with no \"..\" segment, at most 200 characters, with no character of hiddenClass (control, line-separator, bidi, zero-width, soft-hyphen, interlinear, tag, variation-selector, filler, lone-surrogate). A path outside the home is never sent. A why that breaks the rule is ignored (the refusal says no why), never shown",
    "hiddenClass": "\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u034f\\u061c\\u115f\\u1160\\u180e\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2069\\u2800\\u3164\\ud800-\\udfff\\ufe00-\\ufe0f\\ufeff\\uffa0\\ufff9-\\ufffb\\u{1d173}-\\u{1d17a}\\u{e0000}-\\u{e007f}\\u{e0100}-\\u{e01ef}",
    "reasons": [
      "client hook present",
      "project plugin or marketplace",
      "plugin hook present",
      "client settings unreadable",
      "no conditions known",
      "not an interactive session",
      "project directory unknown"
    ],
    "accepted": [
      {
        "why": "a hook in the user's settings",
        "value": {
          "reason": "client hook present",
          "at": "~/.claude/settings.json"
        }
      },
      {
        "why": "a plugin with a hook",
        "value": {
          "reason": "plugin hook present",
          "at": "~/.claude/plugins/cache/example-market/example-plugin/1.0.0"
        }
      },
      {
        "why": "a directory whose name starts with two dots is still under the home",
        "value": {
          "reason": "client hook present",
          "at": "~/..dotfiles/.claude/settings.json"
        }
      },
      {
        "why": "a reason with no place",
        "value": {
          "reason": "not an interactive session"
        }
      }
    ],
    "refused": [
      {
        "why": "not an object",
        "value": "client hook present"
      },
      {
        "why": "a reason outside the set",
        "value": {
          "reason": "something else"
        }
      },
      {
        "why": "an absolute path",
        "value": {
          "reason": "client hook present",
          "at": "/home/example/.claude/settings.json"
        }
      },
      {
        "why": "a path not under ~/",
        "value": {
          "reason": "client hook present",
          "at": "../example/.claude/settings.json"
        }
      },
      {
        "why": "a path that leaves the home by ..",
        "value": {
          "reason": "client hook present",
          "at": "~/../example/.claude/settings.json"
        }
      },
      {
        "why": "a path that leaves the home by a later ..",
        "value": {
          "reason": "client hook present",
          "at": "~/a/../../example/.claude/settings.json"
        }
      },
      {
        "why": "a variation selector in the path",
        "value": {
          "reason": "client hook present",
          "at": "~/.claude/x\ufe0fy"
        }
      },
      {
        "why": "a Hangul filler in the path",
        "value": {
          "reason": "client hook present",
          "at": "~/.claude/x\u3164y"
        }
      },
      {
        "why": "a path over 200 characters",
        "value": {
          "reason": "client hook present",
          "at": "~/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
      },
      {
        "why": "a bidi override in the path",
        "value": {
          "reason": "client hook present",
          "at": "~/.claude/set\u202etings.json"
        }
      },
      {
        "why": "a tag character in the path",
        "value": {
          "reason": "client hook present",
          "at": "~/.claude/settings\udb40\udc41.json"
        }
      },
      {
        "why": "a path that is not a string",
        "value": {
          "reason": "client hook present",
          "at": 7
        }
      },
      {
        "why": "a key beside reason and at",
        "value": {
          "reason": "client hook present",
          "at": "~/.claude/settings.json",
          "path": "/home/example"
        }
      }
    ]
  }
}
